        "selector": "JSXOpeningElement[name.name='VerificationSeal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:inverse|light)$/]",
        "message": "<VerificationSeal> tone must be one of 'inverse' | 'light'."
      }
    ]
