  billboardCode       String?                    @map("billboard_code")
  address             String?
  cityName            String?                    @map("city_name")
  departmentName      String?                    @map("department_name")
  width               Float?
  height              Float?
  quantity            Int                        @default(1)
  impressionPrice     Float                      @map("impression_price")
  rentalPrice         Float                      @map("rental_price")
  /// Recommended unit prices (Brilo catalog rate for the period, impression by
  /// area) the seller started from; the gap to the charged price is the discount.
  listImpressionPrice Float?                     @map("list_impression_price")
  listRentalPrice     Float?                     @map("list_rental_price")
  taxRate             Float                      @default(0.13) @map("tax_rate")
  description         String?
  digitalBillboardId  String?                    @map("digital_billboard_id")
  digitalBillboard    DigitalBillboard?          @relation(fields: [digitalBillboardId], references: [id])
  spotCount           Int?                       @map("spot_count")
