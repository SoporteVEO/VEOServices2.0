generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                       @id
  publicId                   String                       @unique @default(uuid()) @map("public_id")
  firstName                  String                       @map("first_name")
  lastName                   String?                      @map("last_name")
  email                      String                       @unique
  role                       Role                         @default(USER)
  subRoles                   SubRole[]                    @default([]) @map("sub_roles")
  disabled                   Boolean                      @default(false)
  lastLoginAt                DateTime?                    @map("last_login_at")
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  emailVerified              Boolean                      @default(false)
  image                      String?
  accounts                   Account[]
  sessions                   Session[]
  s3Images                   S3Image[]
  teamMember                 TeamMember?                  @relation("TeamMemberUser")
  teamMembersAsBoss          TeamMember[]                 @relation("TeamMemberDirectBoss")
  absences                   Absence[]
  notifications              Notification[]
  metrics                    UserMetrics?
  metricsDays                UserMetricsDay[]
  offersCreated              OfferCreated[]
  installationsAssigned      ProductionOrderItem[]        @relation("ProductionOrderInstaller")
  vulcanizadosAssigned       ProductionOrderItem[]        @relation("ProductionOrderVulcanizador")
  fleetVehiclesCreated       FleetVehicle[]               @relation("FleetVehicleCreatedBy")
  fleetServicesCreated       FleetMaintenance[]           @relation("FleetMaintenanceCreatedBy")
  printJobsCreated           PrintJob[]                   @relation("PrintJobCreatedBy")
  printColorTestsCreated     PrintColorTest[]             @relation("PrintColorTestCreatedBy")
  printRescheduleRequests    PrintRescheduleRequest[]     @relation("PrintRescheduleRequestedBy")
  printRescheduleResolved    PrintRescheduleRequest[]     @relation("PrintRescheduleResolvedBy")
  maintenanceAssigned        MaintenanceJob[]             @relation("MaintenanceAssignee")
  maintenanceCreated         MaintenanceJob[]             @relation("MaintenanceCreatedBy")
  maintenancePhotos          MaintenancePhoto[]           @relation("MaintenancePhotoUploader")
  maintenanceEvents          MaintenanceEvent[]           @relation("MaintenanceEventActor")
  maintenanceComments        MaintenanceComment[]         @relation("MaintenanceCommentAuthor")
  offerEvents                OfferEvent[]                 @relation("OfferEventActor")
  productionOrders           ProductionOrder[]            @relation("ProductionOrderCreatedBy")
  pushSubscriptions          PushSubscription[]
  agentThreads               AgentThread[]
  agentIssuesReported        AgentIssue[]                 @relation("AgentIssueReporter")
  agentIssuesResolved        AgentIssue[]                 @relation("AgentIssueResolver")
  agentFeedback              AgentFeedback[]              @relation("AgentFeedbackAuthor")
  agentFeedbackReviewed      AgentFeedback[]              @relation("AgentFeedbackReviewer")
  learningsProposed          AgentLearning[]              @relation("AgentLearningProposer")
  learningsReviewed          AgentLearning[]              @relation("AgentLearningReviewer")
  crmDealsOwned              CrmDeal[]                    @relation("CrmDealOwner")
  crmDealsCreated            CrmDeal[]                    @relation("CrmDealCreatedBy")
  crmActivities              CrmActivity[]                @relation("CrmActivityActor")
  crmTasksAssigned           CrmTask[]                    @relation("CrmTaskAssignee")
  crmTasksCreated            CrmTask[]                    @relation("CrmTaskCreatedBy")
  crmEmailTemplates          CrmEmailTemplate[]
  crmMessages                CrmMessage[]
  crmConnections             CrmChannelConnection[]
  crmDealSites               CrmDealSite[]                @relation("CrmDealSiteCreatedBy")
  patchNotesCreated          PatchNote[]                  @relation("PatchNoteCreatedBy")
  featureRequests            FeatureRequest[]             @relation("FeatureRequestRequester")
  featureRequestCollabs      FeatureRequestCollaborator[] @relation("FeatureRequestCollaboratorUser")
  featureRequestCollabsAdded FeatureRequestCollaborator[] @relation("FeatureRequestCollaboratorAddedBy")
  featureRequestSignatures   FeatureRequestSignature[]    @relation("FeatureRequestSignatureUser")
  featureRequestEvents       FeatureRequestEvent[]        @relation("FeatureRequestEventActor")

  @@map("users")
}

/// One conversation with the in-app assistant. Messages keep the AI SDK
/// `UIMessage` shape so the chat can be restored exactly as it was streamed.
model AgentThread {
  id        String         @id
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  AgentMessage[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("agent_threads")
}

/// A failure Nexo filed for the dev team. `diagnostics` is captured by the
/// server (tool errors, failed API calls), never written by the model.
model AgentIssue {
  id               String             @id @default(uuid())
  number           Int                @unique @default(autoincrement())
  status           AgentIssueStatus   @default(OPEN)
  severity         AgentIssueSeverity @default(MEDIUM)
  title            String
  summary          String
  technicalDetails String             @map("technical_details")
  userRequest      String             @map("user_request")
  stepsToReproduce String[]           @default([]) @map("steps_to_reproduce")
  expectedBehavior String?            @map("expected_behavior")
  diagnostics      Json
  context          Json
  threadId         String?            @map("thread_id")
  reporterId       String?            @map("reporter_id")
  reporter         User?              @relation("AgentIssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolutionNotes  String?            @map("resolution_notes")
  resolvedAt       DateTime?          @map("resolved_at")
  resolvedById     String?            @map("resolved_by_id")
  resolvedBy       User?              @relation("AgentIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("agent_issues")
}

model AgentMessage {
  id        String      @id
  threadId  String      @map("thread_id")
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  position  Int
  role      String
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([threadId, position])
  @@map("agent_messages")
}

/// A user's rating of one Nexo answer. Messages are rewritten on every turn,
/// so the question, answer and tool calls are snapshotted here instead of
/// referencing `agent_messages`. `review` is a developer's verdict on whether
/// the user's rating was right.
model AgentFeedback {
  id           String               @id @default(uuid())
  userId       String               @map("user_id")
  user         User                 @relation("AgentFeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  threadId     String               @map("thread_id")
  messageId    String               @map("message_id")
  rating       AgentFeedbackRating
  reason       AgentFeedbackReason?
  comment      String?
  question     String
  answer       String
  toolCalls    Json                 @map("tool_calls")
  model        String?
  review       AgentFeedbackReview  @default(PENDING)
  reviewedById String?              @map("reviewed_by_id")
  reviewedBy   User?                @relation("AgentFeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?            @map("reviewed_at")
  learnings    AgentLearning[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([userId, messageId])
  @@index([review, createdAt])
  @@index([threadId])
  @@map("agent_feedback")
}

/// A durable lesson injected into Nexo's prompt. PENDING lessons only apply to
/// the user who taught them; ACTIVE ones apply to everyone.
model AgentLearning {
  id           String              @id @default(uuid())
  content      String
  example      String?
  status       AgentLearningStatus @default(PENDING)
  source       AgentLearningSource
  feedbackId   String?             @map("feedback_id")
  feedback     AgentFeedback?      @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  threadId     String?             @map("thread_id")
  proposedById String?             @map("proposed_by_id")
  proposedBy   User?               @relation("AgentLearningProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  reviewedById String?             @map("reviewed_by_id")
  reviewedBy   User?               @relation("AgentLearningReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@index([proposedById, status])
  @@map("agent_learnings")
}

enum ContractType {
  FULL_TIME
  TEMPORAL
  FREELANCE
  PART_TIME
  INTERNSHIP
  PROFESSIONAL_SERVICES
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

model TeamMember {
  id                           String              @id @default(uuid())
  userId                       String              @unique @map("user_id")
  firstName                    String              @map("first_name")
  lastName                     String?             @map("last_name")
  secondLastName               String?             @map("second_last_name")
  fullName                     String              @map("full_name")
  dui                          String?             @map("dui")
  inss                         String?             @map("inss")
  afpNumber                    String?             @map("afp_number")
  afpEntity                    String?             @map("afp_entity")
  bankName                     String?             @map("bank_name")
  bankAccount                  String?             @map("bank_account")
  bornDate                     DateTime?           @map("born_date")
  startDate                    DateTime?           @map("start_date")
  endDate                      DateTime?           @map("end_date")
  contractType                 ContractType        @default(FULL_TIME)
  status                       TeamMemberStatus    @default(ACTIVE)
  emergencyContactName         String?             @map("emergency_contact_name")
  emergencyContactPhone        String?             @map("emergency_contact_phone")
  emergencyContactRelationship String?             @map("emergency_contact_relationship")
  directBoss                   User?               @relation("TeamMemberDirectBoss", fields: [directBossId], references: [id])
  directBossId                 String?             @map("direct_boss_id")
  businessEmail                String              @unique @map("business_email")
  position                     String
  salary                       Float
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  user                         User                @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  teamMemberComments           TeamMemberComment[]
  reportSended                 ReportSended[]

  @@index([userId])
  @@map("team_members")
}

model TeamMemberComment {
  id           String     @id @default(uuid())
  teamMemberId String     @map("team_member_id")
  comment      String
  showToUser   Boolean    @default(false) @map("show_to_user")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@map("team_member_comments")
}

model Absence {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  fromDate  DateTime       @map("from_date")
  toDate    DateTime       @map("to_date")
  reason    String
  status    AbsenceStatus  @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    AbsenceImage[]

  @@index([userId])
  @@map("absences")
}

model AbsenceImage {
  id        String   @id @default(uuid())
  absenceId String   @map("absence_id")
  url       String
  createdAt DateTime @default(now())
  absence   Absence  @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@index([absenceId])
  @@map("absence_images")
}

model Notification {
  id          String                 @id @default(uuid())
  userId      String                 @map("user_id")
  status      UserNotificationStatus @default(PENDING)
  description String
  priority    NotificationPriority   @default(MEDIUM)
  /// In-app path the notification opens when clicked.
  href        String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Release notes shown in "Actualizaciones". `body` is markdown.
model PatchNote {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  body        String
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("PatchNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("patch_notes")
}

enum FeatureRequestStatus {
  SUBMITTED
  IN_REVIEW
  IN_PROGRESS
  /// Built by the dev team and waiting for every participant to sign.
  COMPLETED
  /// Every participant signed the current completion round.
  APPROVED
  REJECTED
}

enum FeatureRequestPriority {
  LOW
  MEDIUM
  HIGH
}

enum FeatureRequestEventType {
  CREATED
  STATUS_CHANGED
  COMMENT
  COLLABORATOR_ADDED
  COLLABORATOR_REMOVED
  SIGNED
  PROBLEM_REPORTED
  APPROVED
}

/// A feature a user asks the dev team to build. The filled-in request form is
/// archived as a PDF. The participants (requester plus collaborators) sign off
/// once dev marks it completed; `completionRound` counts those hand-overs so a
/// signature always refers to one specific delivery.
model FeatureRequest {
  id              String                       @id @default(uuid())
  number          Int                          @unique @default(autoincrement())
  title           String
  summary         String
  priority        FeatureRequestPriority       @default(MEDIUM)
  status          FeatureRequestStatus         @default(SUBMITTED)
  requesterId     String                       @map("requester_id")
  requester       User                         @relation("FeatureRequestRequester", fields: [requesterId], references: [id])
  fileS3Key       String                       @map("file_s3_key")
  fileName        String                       @map("file_name")
  fileSize        Int                          @map("file_size")
  completionRound Int                          @default(0) @map("completion_round")
  completedAt     DateTime?                    @map("completed_at")
  approvedAt      DateTime?                    @map("approved_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  collaborators   FeatureRequestCollaborator[]
  signatures      FeatureRequestSignature[]
  events          FeatureRequestEvent[]

  @@index([status, createdAt])
  @@index([requesterId])
  @@map("feature_requests")
}

model FeatureRequestCollaborator {
  id        String         @id @default(uuid())
  requestId String         @map("request_id")
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")
  user      User           @relation("FeatureRequestCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?        @map("added_by_id")
  addedBy   User?          @relation("FeatureRequestCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([requestId, userId])
  @@index([userId])
  @@map("feature_request_collaborators")
}

/// Evidence that a participant accepted one delivery. The signer's name and
/// email are copied here so the record survives the account being deleted.
model FeatureRequestSignature {
  id          String         @id @default(uuid())
  requestId   String         @map("request_id")
  request     FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId      String?        @map("user_id")
  user        User?          @relation("FeatureRequestSignatureUser", fields: [userId], references: [id], onDelete: SetNull)
  round       Int
  signerName  String         @map("signer_name")
  signerEmail String         @map("signer_email")
  imageS3Key  String         @map("image_s3_key")
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  signedAt    DateTime       @default(now()) @map("signed_at")

  @@unique([requestId, userId, round])
  @@index([requestId, round])
  @@map("feature_request_signatures")
}

model FeatureRequestEvent {
  id          String                  @id @default(uuid())
  requestId   String                  @map("request_id")
  request     FeatureRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type        FeatureRequestEventType
  fromStatus  FeatureRequestStatus?   @map("from_status")
  toStatus    FeatureRequestStatus?   @map("to_status")
  message     String?
  actorUserId String?                 @map("actor_user_id")
  actor       User?                   @relation("FeatureRequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now()) @map("created_at")

  @@index([requestId, createdAt])
  @@map("feature_request_events")
}

/// Web Push endpoint of one installed browser/PWA. The endpoint is unique per
/// device, so a phone shared between users follows whoever subscribed last.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

model UserMetrics {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  lastTickAt DateTime @default(now()) @map("last_tick_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metrics")
}

model UserMetricsDay {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  activeMs  Int      @default(0) @map("active_ms")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_metrics_days")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model NotifiedContract {
  id                     String             @id @default(uuid())
  contractSourceId       Int
  contractDetailSourceId Int
  contractNumber         String
  status                 NotificationStatus @default(PENDING)
  errorMessage           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("notified_contract")
}

model Customer {
  id        String     @id @default(uuid())
  name      String?
  email     String     @unique
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("customers")
}

model Purchase {
  id              String         @id @default(uuid())
  customerId      String
  status          PurchaseStatus @default(PENDING)
  paypalOrderId   String?
  paypalCaptureId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           PurchaseItem[]
  customer        Customer       @relation(fields: [customerId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id                 String            @id @default(uuid())
  purchaseId         String
  billboardId        Int?
  billboardCode      String?
  reference          String?
  departmentName     String?
  cityName           String?
  address            String?
  price              Float?
  from               DateTime
  to                 DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  digitalBillboardId String?
  spotCount          Int?
  digitalBillboard   DigitalBillboard? @relation(fields: [digitalBillboardId], references: [id])
  purchase           Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([billboardId, from, to])
  @@index([digitalBillboardId, from, to])
  @@map("purchase_items")
}

model Image {
  id                String             @id @default(uuid())
  completeUrl       String
  thumbnailUrl      String
  mediumUrl         String
  deleteUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  digitalBillboards DigitalBillboard[]

  @@map("images")
}

/// Pantallas (DOOH). `maxSpots` stays as the shop pricing basis; real capacity
/// is the operating hours times `DigitalBillboardSettings.spotsPerHour`.
model DigitalBillboard {
  id             String  @id @default(uuid())
  code           String  @unique
  name           String
  address        String
  latitude       Float
  longitude      Float
  price          Float
  imageId        String?
  maxSpots       Int     @default(900)
  departmentId   Int?    @map("department_id")
  departmentName String? @map("department_name")

  turnOnAt  String   @default("05:30") @map("turn_on_at")
  turnOffAt String   @default("22:00") @map("turn_off_at")
  position  Int      @default(0)
  /// Lowercase, accent-free names used to recognise the screen in an OP file.
  aliases   String[] @default([])

  lastChangeClient String?   @map("last_change_client")
  lastChangeAction String?   @map("last_change_action")
  lastChangeAt     DateTime? @map("last_change_at")

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  sublists        DigitalBillboardSublist[]
  offerItems      OfferCreatedItem[]
  image           Image?                    @relation(fields: [imageId], references: [id])
  purchaseItems   PurchaseItem[]
  crmDealSites    CrmDealSite[]
  maintenanceJobs MaintenanceJob[]
  orderScreens    DigitalOrderScreen[]

  @@map("digital_billboards")
}

model DigitalBillboardSettings {
  id           Int      @id @default(1)
  spotsPerHour Int      @default(450) @map("spots_per_hour")
  minHours     Float    @default(16.5) @map("min_hours")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("digital_billboard_settings")
}

model DigitalBillboardSublist {
  id                 String           @id @default(uuid())
  digitalBillboardId String           @map("digital_billboard_id")
  digitalBillboard   DigitalBillboard @relation(fields: [digitalBillboardId], references: [id], onDelete: Cascade)
  name               String
  capacity           Int              @default(900)
  position           Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  campaigns DigitalBillboardCampaign[]

  @@index([digitalBillboardId, position])
  @@map("digital_billboard_sublists")
}

enum DigitalCampaignArt {
  RECEIVED
  MISSING
  PENDING_APPROVAL
}

enum DigitalCampaignDeal {
  COMMERCIAL
  DONATION
  EXCHANGE
  DATION
  BONUS
}

model DigitalBillboardCampaign {
  id          String                  @id @default(uuid())
  sublistId   String                  @map("sublist_id")
  sublist     DigitalBillboardSublist @relation(fields: [sublistId], references: [id], onDelete: Cascade)
  client      String
  campaign    String                  @default("")
  startDate   DateTime?               @map("start_date") @db.Date
  endDate     DateTime?               @map("end_date") @db.Date
  spotsPerDay Int                     @map("spots_per_day")
  notes       String?
  paused      Boolean                 @default(false)
  pauseReason String?                 @map("pause_reason")
  art         DigitalCampaignArt      @default(RECEIVED)
  deal        DigitalCampaignDeal     @default(COMMERCIAL)

  monthlyValue Float? @map("monthly_value")
  spotValue    Float? @map("spot_value")
  /// Manual "valor total de la OP"; when null the total is the sum of screens.
  totalValue   Float? @map("total_value")

  /// Shared by every row entered through the same OP.
  orderGroupId String?           @map("order_group_id")
  /// Set when the campaign comes from an accepted offer; removed with it.
  offerItemId  String?           @map("offer_item_id")
  offerItem    OfferCreatedItem? @relation(fields: [offerItemId], references: [id], onDelete: Cascade)

  createdAt DateTime                          @default(now()) @map("created_at")
  updatedAt DateTime                          @updatedAt @map("updated_at")
  versions  DigitalBillboardCampaignVersion[]

  @@index([sublistId])
  @@index([client])
  @@index([orderGroupId])
  @@index([offerItemId])
  @@index([startDate, endDate])
  @@map("digital_billboard_campaigns")
}

model DigitalBillboardCampaignVersion {
  id         String                   @id @default(uuid())
  campaignId String                   @map("campaign_id")
  campaign   DigitalBillboardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String                   @default("")
