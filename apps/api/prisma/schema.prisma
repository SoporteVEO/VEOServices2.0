/// Append-only audit trail for offers. Powers the "Historial" tab and answers
/// "who changed the price, and when" for both analytics and security reviews.
model OfferEvent {
  id      String       @id @default(uuid())
  offerId String       @map("offer_id")
  offer   OfferCreated @relation(fields: [offerId], references: [id], onDelete: Cascade)

  type    OfferEventType
  message String

  /// Field-level diff, shaped as `{ field: { from, to } }`. Null for events
  /// that carry no before/after value (creation, PDF replacement).
  changes Json?

  /// Why the seller edited the offer. Required whenever billboards were added
  /// or removed, so analytics can explain shrinking or growing campaigns.
  editReason       OfferEditReason? @map("edit_reason")
  editReasonNote   String?          @map("edit_reason_note")
  /// Billboard lines (static + digital) and grand total around a content edit.
  billboardsBefore Int?             @map("billboards_before")
  billboardsAfter  Int?             @map("billboards_after")
  amountBefore     Float?           @map("amount_before")
  amountAfter      Float?           @map("amount_after")

  actorUserId String? @map("actor_user_id")
  actor       User?   @relation("OfferEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
  @@index([type, createdAt])
  @@index([editReason, createdAt])
  @@map("offer_events")
}

model OfferCreatedItem {
