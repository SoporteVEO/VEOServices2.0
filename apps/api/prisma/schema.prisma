generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id
  publicId              String                @unique @default(uuid()) @map("public_id")
  firstName             String                @map("first_name")
  lastName              String?               @map("last_name")
  email                 String                @unique
  role                  Role                  @default(USER)
  subRoles              SubRole[]             @default([]) @map("sub_roles")
  disabled              Boolean               @default(false)
  lastLoginAt           DateTime?             @map("last_login_at")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  emailVerified         Boolean               @default(false)
  image                 String?
  accounts              Account[]
  sessions              Session[]
  s3Images              S3Image[]
  teamMember            TeamMember?           @relation("TeamMemberUser")
  teamMembersAsBoss     TeamMember[]          @relation("TeamMemberDirectBoss")
  absences              Absence[]
  notifications         Notification[]
  metrics               UserMetrics?
  metricsDays           UserMetricsDay[]
  offersCreated         OfferCreated[]
  installationsAssigned ProductionOrderItem[] @relation("ProductionOrderInstaller")
  printJobsCreated      PrintJob[]            @relation("PrintJobCreatedBy")
  maintenanceAssigned   MaintenanceJob[]      @relation("MaintenanceAssignee")
  maintenanceCreated    MaintenanceJob[]      @relation("MaintenanceCreatedBy")
  maintenancePhotos     MaintenancePhoto[]    @relation("MaintenancePhotoUploader")
  maintenanceEvents     MaintenanceEvent[]    @relation("MaintenanceEventActor")
  offerEvents           OfferEvent[]          @relation("OfferEventActor")

  @@map("users")
}

enum ContractType {
  FULL_TIME
  TEMPORAL
  FREELANCE
  PART_TIME
  INTERNSHIP
  PROFESSIONAL_SERVICES
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

model TeamMember {
  id                           String              @id @default(uuid())
  userId                       String              @unique @map("user_id")
  firstName                    String              @map("first_name")
  lastName                     String?             @map("last_name")
  secondLastName               String?             @map("second_last_name")
  fullName                     String              @map("full_name")
  dui                          String?             @map("dui")
  inss                         String?             @map("inss")
  afpNumber                    String?             @map("afp_number")
  afpEntity                    String?             @map("afp_entity")
  bankName                     String?             @map("bank_name")
  bankAccount                  String?             @map("bank_account")
  bornDate                     DateTime?           @map("born_date")
  startDate                    DateTime?           @map("start_date")
  endDate                      DateTime?           @map("end_date")
  contractType                 ContractType        @default(FULL_TIME)
  status                       TeamMemberStatus    @default(ACTIVE)
  emergencyContactName         String?             @map("emergency_contact_name")
  emergencyContactPhone        String?             @map("emergency_contact_phone")
  emergencyContactRelationship String?             @map("emergency_contact_relationship")
  directBoss                   User?               @relation("TeamMemberDirectBoss", fields: [directBossId], references: [id])
  directBossId                 String?             @map("direct_boss_id")
  businessEmail                String              @unique @map("business_email")
  position                     String
  salary                       Float
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  user                         User                @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  teamMemberComments           TeamMemberComment[]
  reportSended                 ReportSended[]

  @@index([userId])
  @@map("team_members")
}

model TeamMemberComment {
  id           String     @id @default(uuid())
  teamMemberId String     @map("team_member_id")
  comment      String
  showToUser   Boolean    @default(false) @map("show_to_user")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@map("team_member_comments")
}

model Absence {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  fromDate  DateTime       @map("from_date")
  toDate    DateTime       @map("to_date")
  reason    String
  status    AbsenceStatus  @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    AbsenceImage[]

  @@index([userId])
  @@map("absences")
}

model AbsenceImage {
  id        String   @id @default(uuid())
  absenceId String   @map("absence_id")
  url       String
  createdAt DateTime @default(now())
  absence   Absence  @relation(fields: [absenceId], references: [id], onDelete: Cascade)

  @@index([absenceId])
  @@map("absence_images")
}

model Notification {
  id          String                 @id @default(uuid())
  userId      String                 @map("user_id")
  status      UserNotificationStatus @default(PENDING)
  description String
  priority    NotificationPriority   @default(MEDIUM)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

model UserMetrics {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  lastTickAt DateTime @default(now()) @map("last_tick_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metrics")
}

model UserMetricsDay {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  activeMs  Int      @default(0) @map("active_ms")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_metrics_days")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model NotifiedContract {
  id                     String             @id @default(uuid())
  contractSourceId       Int
  contractDetailSourceId Int
  contractNumber         String
  status                 NotificationStatus @default(PENDING)
  errorMessage           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@map("notified_contract")
}

model Customer {
  id        String     @id @default(uuid())
  name      String?
  email     String     @unique
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("customers")
}

model Purchase {
  id              String         @id @default(uuid())
  customerId      String
  status          PurchaseStatus @default(PENDING)
  paypalOrderId   String?
  paypalCaptureId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           PurchaseItem[]
  customer        Customer       @relation(fields: [customerId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id                 String            @id @default(uuid())
  purchaseId         String
  billboardId        Int?
  billboardCode      String?
  reference          String?
  departmentName     String?
  cityName           String?
  address            String?
  price              Float?
  from               DateTime
  to                 DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  digitalBillboardId String?
  spotCount          Int?
  digitalBillboard   DigitalBillboard? @relation(fields: [digitalBillboardId], references: [id])
  purchase           Purchase          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([billboardId, from, to])
  @@index([digitalBillboardId, from, to])
  @@map("purchase_items")
}

model Image {
  id                String             @id @default(uuid())
  completeUrl       String
  thumbnailUrl      String
  mediumUrl         String
  deleteUrl         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  digitalBillboards DigitalBillboard[]

  @@map("images")
}

model DigitalBillboardUsage {
  id                  String            @id @default(uuid())
  digitalBillboardId  String
  timestamp           DateTime
  duration            Int
  campaignName        String?
  campaignDescription String?
  offerItemId         String?           @map("offer_item_id")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  digitalBillboard    DigitalBillboard  @relation(fields: [digitalBillboardId], references: [id])
  offerItem           OfferCreatedItem? @relation(fields: [offerItemId], references: [id], onDelete: SetNull)

  @@index([digitalBillboardId, timestamp])
  @@index([offerItemId])
  @@map("digital_billboard_usages")
}

model DigitalBillboard {
  id                     String                  @id @default(uuid())
  code                   String                  @unique
  name                   String
  address                String
  latitude               Float
  longitude              Float
  price                  Float
  imageId                String?
  maxSpots               Int                     @default(900)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  departmentId           Int?                    @map("department_id")
  departmentName         String?                 @map("department_name")
  digitalBillboardUsages DigitalBillboardUsage[]
  offerItems             OfferCreatedItem[]
  image                  Image?                  @relation(fields: [imageId], references: [id])
  purchaseItems          PurchaseItem[]

  @@map("digital_billboards")
}

enum Role {
  ADMIN
  USER
  LIMITED
  INSTALLER
  WORKER
  MANTENIMIENTO
}

enum SubRole {
  HR
  USERS_MANAGEMENT
  PRODUCTION
  MANTENIMIENTO
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserNotificationStatus {
  PENDING
  VIEWED
  DELETED
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum S3ImageType {
  STATIC_BILLBOARD_MONTHLY
  STATIC_BILLBOARD_MAINTENANCE
  STATIC_BILLBOARD_INSTALLATION
}

model S3Image {
  id                    String                @id @default(uuid())
  url                   String
  deleteUrl             String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  uploadedUserId        String
  uploadedUser          User                  @relation(fields: [uploadedUserId], references: [id])
  tags                  String[]              @default([])
  staticBillboardCodeId String?
  staticBillboardCode   StaticBillboardCodes? @relation(fields: [staticBillboardCodeId], references: [id])
  type                  S3ImageType
  productionOrderItemId String?               @map("production_order_item_id")
  productionOrderItem   ProductionOrderItem?  @relation(fields: [productionOrderItemId], references: [id], onDelete: SetNull)
  maintenancePhoto      MaintenancePhoto?

  @@index([productionOrderItemId])
  @@map("s3_images")
}

model StaticBillboardCodes {
  id            String         @id @default(uuid())
  code          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  s3Images      S3Image[]
  reportSendeds ReportSended[]

  @@map("static_billboard_codes")
}

enum ReportType {
  MONTHLY
  INSTALLATION
  MAINTENANCE
}

model ReportSended {
  id                    String                @id @default(uuid())
  teamMemberId          String                @map("team_member_id")
  teamMember            TeamMember            @relation(fields: [teamMemberId], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reportType            ReportType            @default(MONTHLY)
  contractNumber        String                @map("contract_number")
  staticBillboardCodeId String?
  staticBillboardCode   StaticBillboardCodes? @relation(fields: [staticBillboardCodeId], references: [id])
  sentToEmail           String?               @map("sent_to_email")
  /// First day of the month the report covers. Distinct from `createdAt`,
  /// since a report for a past month can be sent today.
  periodStart           DateTime              @map("period_start")

  @@index([contractNumber, reportType, periodStart])
  @@map("report_sended")
}

model Client {
  id           String         @id @default(uuid())
  name         String
  company      String?
  email        String         @unique
  billingEmail String?        @map("billing_email")
  contact      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  offers       OfferCreated[]

  @@index([company])
  @@index([name])
  @@map("clients")
}

enum OfferStatus {
  PENDING
  DECLINED
  ACCEPTED
}

enum OfferItemType {
  STATIC_BILLBOARD
  DIGITAL_BILLBOARD
  MISC
}

model OfferCreated {
  id                 String             @id @default(uuid())
  offerNumber        String             @unique @map("offer_number")
  clientId           String?            @map("client_id")
  client             Client?            @relation(fields: [clientId], references: [id])
  customerName       String             @map("customer_name")
  customerCompany    String?            @map("customer_company")
  customerEmail      String?            @map("customer_email")
  billingEmail       String?            @map("billing_email")
  customerContact    String?            @map("customer_contact")
  validUntil         DateTime           @map("valid_until")
  specialConditions  String?            @map("special_conditions")
  advisorFullName    String?            @map("advisor_full_name")
  status             OfferStatus        @default(PENDING)
  briloMconId        Int?               @map("brilo_mcon_id")
  subtotalImpression Float              @map("subtotal_impression")
  ivaImpression      Float              @map("iva_impression")
  totalImpression    Float              @map("total_impression")
  subtotalRental     Float              @map("subtotal_rental")
  ivaRental          Float              @map("iva_rental")
  totalRental        Float              @map("total_rental")
  pdfS3Key           String?            @map("pdf_s3_key")
  createdByUserId    String             @map("created_by_user_id")
  createdBy          User               @relation(fields: [createdByUserId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  items              OfferCreatedItem[]
  productionOrder    ProductionOrder?
  events             OfferEvent[]

  @@index([createdAt])
  @@index([createdByUserId])
  @@index([clientId])
  @@index([status])
  @@map("offers_created")
}

enum OfferEventType {
  CREATED
  UPDATED
  ITEMS_UPDATED
  PDF_ATTACHED
  ACCEPTED
  DECLINED
  REOPENED
}

/// Append-only audit trail for offers. Powers the "Historial" tab and answers
/// "who changed the price, and when" for both analytics and security reviews.
model OfferEvent {
  id      String       @id @default(uuid())
  offerId String       @map("offer_id")
  offer   OfferCreated @relation(fields: [offerId], references: [id], onDelete: Cascade)

  type    OfferEventType
  message String

  /// Field-level diff, shaped as `{ field: { from, to } }`. Null for events
  /// that carry no before/after value (creation, PDF replacement).
  changes Json?

  actorUserId String? @map("actor_user_id")
  actor       User?   @relation("OfferEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
  @@index([type, createdAt])
  @@map("offer_events")
}

model OfferCreatedItem {
  id                     String                  @id @default(uuid())
  offerId                String                  @map("offer_id")
  offer                  OfferCreated            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  itemType               OfferItemType           @default(STATIC_BILLBOARD) @map("item_type")
  billboardId            Int?                    @map("billboard_id")
  billboardCode          String?                 @map("billboard_code")
  address                String?
  cityName               String?                 @map("city_name")
  departmentName         String?                 @map("department_name")
  width                  Float?
  height                 Float?
  quantity               Int                     @default(1)
  impressionPrice        Float                   @map("impression_price")
  rentalPrice            Float                   @map("rental_price")
  taxRate                Float                   @default(0.13) @map("tax_rate")
  description            String?
  digitalBillboardId     String?                 @map("digital_billboard_id")
  digitalBillboard       DigitalBillboard?       @relation(fields: [digitalBillboardId], references: [id])
  spotCount              Int?                    @map("spot_count")
  startDate              DateTime?               @map("start_date")
  endDate                DateTime?               @map("end_date")
  createdAt              DateTime                @default(now())
  digitalBillboardUsages DigitalBillboardUsage[]
  productionOrderItem    ProductionOrderItem?

  @@index([offerId])
  @@index([digitalBillboardId])
  @@map("offers_created_items")
}

enum ProductionOrderStatus {
  RECEIVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

/// A press. `printSpeedM2PerHour` is its throughput, which is what turns a
/// panel's area into a print duration, and `dailyCapacityM2` caps how much
/// area may be scheduled on it within one calendar day.
model PrintingMachine {
  id                  String     @id @default(uuid())
  name                String
  position            Int        @default(0)
  setupMinutes        Int        @default(15) @map("setup_minutes")
  cooldownMinutes     Int        @default(10) @map("cooldown_minutes")
  printSpeedM2PerHour Float      @default(85) @map("print_speed_m2_per_hour")
  dailyCapacityM2     Float      @default(595) @map("daily_capacity_m2")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  printJobs           PrintJob[]

  @@map("printing_machines")
}

enum PrintJobStatus {
  SCHEDULED
  SETUP
  PRINTING
  COOLDOWN
  COMPLETED
  CANCELLED
}

/// One pass of a static billboard through a printing machine. Planned minutes
/// and area are frozen at scheduling time; the `*StartedAt` columns are stamped
/// as the operator advances the job so analytics can compare planned versus
/// actual.
model PrintJob {
  id                    String              @id @default(uuid())
  machineId             String              @map("machine_id")
  machine               PrintingMachine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  productionOrderItemId String              @map("production_order_item_id")
  productionOrderItem   ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  status                PrintJobStatus      @default(SCHEDULED)

  scheduledStartAt DateTime @map("scheduled_start_at")
  setupMinutes     Int      @map("setup_minutes")
  printMinutes     Int      @map("print_minutes")
  cooldownMinutes  Int      @map("cooldown_minutes")
  /// Printed area for this pass, the unit the machine's daily capacity is
  /// measured in. Frozen here so a later edit to the offer item cannot
  /// retroactively change a day's consumed capacity.
  areaM2           Float    @default(0) @map("area_m2")

  setupStartedAt    DateTime? @map("setup_started_at")
  printStartedAt    DateTime? @map("print_started_at")
  cooldownStartedAt DateTime? @map("cooldown_started_at")
  completedAt       DateTime? @map("completed_at")
  cancelledAt       DateTime? @map("cancelled_at")

  notes           String?
  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("PrintJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId, scheduledStartAt])
  @@index([productionOrderItemId])
  @@index([status])
  @@index([scheduledStartAt])
  @@map("print_jobs")
}

model ProductionOrder {
  id        String                @id @default(uuid())
  offerId   String                @unique @map("offer_id")
  offer     OfferCreated          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     ProductionOrderItem[]

  @@map("production_orders")
}

model ProductionOrderItem {
  id                      String                @id @default(uuid())
  productionOrderId       String                @map("production_order_id")
  productionOrder         ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  offerItemId             String                @unique @map("offer_item_id")
  offerItem               OfferCreatedItem      @relation(fields: [offerItemId], references: [id], onDelete: Cascade)
  status                  ProductionOrderStatus @default(RECEIVED)
  productionDocumentS3Key String?               @map("production_document_s3_key")
  designDocumentS3Key     String?               @map("design_document_s3_key")
  assignedInstallerId     String?               @map("assigned_installer_id")
  assignedInstaller       User?                 @relation("ProductionOrderInstaller", fields: [assignedInstallerId], references: [id], onDelete: SetNull)
  scheduledInstallationAt DateTime?             @map("scheduled_installation_at")
  installedAt             DateTime?             @map("installed_at")
  vulcanizadoImageS3Key   String?               @map("vulcanizado_image_s3_key")
  installationImages      S3Image[]
  printJobs               PrintJob[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([productionOrderId])
  @@index([status])
  @@index([assignedInstallerId])
  @@map("production_order_items")
}

enum MaintenanceJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceEventType {
  CREATED
  UPDATED
  REASSIGNED
  RESCHEDULED
  STARTED
  PHOTO_UPLOADED
  PHOTO_DELETED
  COMPLETED
  REOPENED
  CANCELLED
}

/// User-managed tags for maintenance work, e.g. "Estructura", "Iluminación".
model MaintenanceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs MaintenanceJob[]

  @@index([archived])
  @@map("maintenance_categories")
}

model MaintenanceJob {
  id   String @id @default(uuid())
  code String @unique

  /// Brilo static billboard. The descriptive columns are copied on create so
  /// the job keeps reading correctly even if the catalog entry changes later.
  billboardId    Int?    @map("billboard_id")
  billboardCode  String? @map("billboard_code")
  address        String?
  cityName       String? @map("city_name")
  departmentName String? @map("department_name")
  width          Float?
  height         Float?

  categoryId String?              @map("category_id")
  category   MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  assignedUserId String @map("assigned_user_id")
  assignedUser   User   @relation("MaintenanceAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)

  description String
  scheduledAt DateTime             @map("scheduled_at")
  status      MaintenanceJobStatus @default(PENDING)

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  completionNotes String?   @map("completion_notes")

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("MaintenanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos MaintenancePhoto[]
  events MaintenanceEvent[]

  @@index([assignedUserId, status])
  @@index([status])
  @@index([scheduledAt])
  @@index([categoryId])
  @@index([billboardId])
  @@map("maintenance_jobs")
}

/// Proof-of-work photos. Deliberately kept out of `s3_images` so they never
/// surface in the Imágenes module on their own; a supervisor may publish an
/// individual photo there, which is what `s3Image` records.
model MaintenancePhoto {
  id    String         @id @default(uuid())
  jobId String         @map("job_id")
  job   MaintenanceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  s3Key String  @map("s3_key")
  note  String?

  uploadedByUserId String? @map("uploaded_by_user_id")
  uploadedBy       User?   @relation("MaintenancePhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  /// Copy published to the Imágenes module, if any. Cleared when that copy is
  /// deleted there, so the photo can be published again.
  s3ImageId String?  @unique @map("s3_image_id")
  s3Image   S3Image? @relation(fields: [s3ImageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@map("maintenance_photos")
}

/// Append-only trail powering the "Historial" tab and maintenance analytics.
model MaintenanceEvent {
  id    String         @id @default(uuid())
  jobId String         @map("job_id")
  job   MaintenanceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  type    MaintenanceEventType
  message String?

  actorUserId String? @map("actor_user_id")
  actor       User?   @relation("MaintenanceEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([type, createdAt])
  @@map("maintenance_events")
}
