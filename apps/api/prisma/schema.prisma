/// A press. `printSpeedM2PerHour` is its throughput, which is what turns a
/// panel's area into a print duration, and `dailyCapacityM2` caps how much
/// area may be scheduled on it within one calendar day.
model PrintingMachine {
  id                  String     @id @default(uuid())
  name                String
  position            Int        @default(0)
  setupMinutes        Int        @default(15) @map("setup_minutes")
  cooldownMinutes     Int        @default(10) @map("cooldown_minutes")
  printSpeedM2PerHour Float      @default(85) @map("print_speed_m2_per_hour")
  dailyCapacityM2     Float      @default(595) @map("daily_capacity_m2")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  printJobs           PrintJob[]

  @@map("printing_machines")
}

enum PrintJobStatus {
  SCHEDULED
  SETUP
  PRINTING
  COOLDOWN
  COMPLETED
  CANCELLED
}

enum PrintJobKind {
  PRODUCTION
  COLOR_TEST
}

/// A color test requested for a billboard before its real print. It waits in
/// the backlog until dropped on a machine, which creates a `COLOR_TEST` job.
model PrintColorTest {
  id                    String              @id @default(uuid())
  productionOrderItemId String              @map("production_order_item_id")
  productionOrderItem   ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  durationMinutes       Int                 @map("duration_minutes")
  notes                 String?
  createdByUserId       String?             @map("created_by_user_id")
  createdBy             User?               @relation("PrintColorTestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  printJobs             PrintJob[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([productionOrderItemId])
  @@map("print_color_tests")
}

/// One pass of a static billboard through a printing machine. Planned minutes
/// and area are frozen at scheduling time; the `*StartedAt` columns are stamped
/// as the operator advances the job so analytics can compare planned versus
/// actual.
model PrintJob {
  id                    String              @id @default(uuid())
  machineId             String              @map("machine_id")
  machine               PrintingMachine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  productionOrderItemId String              @map("production_order_item_id")
  productionOrderItem   ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  status                PrintJobStatus      @default(SCHEDULED)
  kind                  PrintJobKind        @default(PRODUCTION)
  colorTestId           String?             @map("color_test_id")
  colorTest             PrintColorTest?     @relation(fields: [colorTestId], references: [id], onDelete: Cascade)

  scheduledStartAt DateTime @map("scheduled_start_at")
  setupMinutes     Int      @map("setup_minutes")
  printMinutes     Int      @map("print_minutes")
  cooldownMinutes  Int      @map("cooldown_minutes")
  /// Printed area for this pass, the unit the machine's daily capacity is
  /// measured in. Frozen here so a later edit to the offer item cannot
  /// retroactively change a day's consumed capacity.
  areaM2           Float    @default(0) @map("area_m2")

  setupStartedAt    DateTime? @map("setup_started_at")
  printStartedAt    DateTime? @map("print_started_at")
  cooldownStartedAt DateTime? @map("cooldown_started_at")
  completedAt       DateTime? @map("completed_at")
  cancelledAt       DateTime? @map("cancelled_at")

  notes           String?
  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("PrintJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId, scheduledStartAt])
  @@index([productionOrderItemId])
  @@index([colorTestId])
  @@index([status])
  @@index([scheduledStartAt])
  @@map("print_jobs")
}

enum PrintRescheduleStatus {
  PENDING
  RESOLVED
  REJECTED
  CANCELLED
}

/// A salesperson asking production to move (usually advance) the print of a
/// billboard. Only one request per billboard may be PENDING at a time.
model PrintRescheduleRequest {
  id                    String                @id @default(uuid())
  productionOrderItemId String                @map("production_order_item_id")
  productionOrderItem   ProductionOrderItem   @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  status                PrintRescheduleStatus @default(PENDING)
  isUrgent              Boolean               @default(false) @map("is_urgent")
  /// Day the requester would like the billboard printed, if any.
  preferredDate         DateTime?             @map("preferred_date")
  reason                String
  /// Print start the requester saw when asking, to tell whether it moved.
  previousStartAt       DateTime?             @map("previous_start_at")
  requestedByUserId     String                @map("requested_by_user_id")
  requestedBy           User                  @relation("PrintRescheduleRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  resolvedByUserId      String?               @map("resolved_by_user_id")
  resolvedBy            User?                 @relation("PrintRescheduleResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNote        String?               @map("resolution_note")
  resolvedAt            DateTime?             @map("resolved_at")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([productionOrderItemId, status])
  @@index([status, createdAt])
  @@map("print_reschedule_requests")
}

