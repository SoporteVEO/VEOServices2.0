  cityName                String?                  @map("city_name")
  departmentName          String?                  @map("department_name")
  width                   Float?
  height                  Float?
  quantity                Int                      @default(1)
  status                  ProductionOrderStatus    @default(RECEIVED)
  /// Deprecated: replaced by the per-billboard art. Kept read-only for older orders.
  productionDocumentS3Key String?                  @map("production_document_s3_key")
  /// Deprecated: replaced by the per-billboard art. Kept read-only for older orders.
  designDocumentS3Key     String?                  @map("design_document_s3_key")
  artS3Key                String?                  @map("art_s3_key")
  artFileName             String?                  @map("art_file_name")
  artMimeType             String?                  @map("art_mime_type")
  artUploadedAt           DateTime?                @map("art_uploaded_at")
  assignedInstallerId     String?                  @map("assigned_installer_id")
  assignedInstaller       User?                    @relation("ProductionOrderInstaller", fields: [assignedInstallerId], references: [id], onDelete: SetNull)
  assignedVulcanizadorId  String?                  @map("assigned_vulcanizador_id")
  assignedVulcanizador    User?                    @relation("ProductionOrderVulcanizador", fields: [assignedVulcanizadorId], references: [id], onDelete: SetNull)
  scheduledInstallationAt DateTime?                @map("scheduled_installation_at")
  installedAt             DateTime?                @map("installed_at")
  vulcanizadoImageS3Key   String?                  @map("vulcanizado_image_s3_key")
  installationImages      S3Image[]
