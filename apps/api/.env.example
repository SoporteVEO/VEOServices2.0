# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/veo_services"

# SQL Server (Brilo legacy database)
SQLSERVER_HOST="your-sql-server-host"
SQLSERVER_PORT=1433
SQLSERVER_USERNAME="sa"
SQLSERVER_PASSWORD="your-password"
SQLSERVER_DATABASE="master"

# Resend (email)
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="soporte.dev@arhedes.com.sv"
RESEND_TEST_TO_EMAIL="soporte.dev@arhedes.com.sv"

# PayPal
PAYPAL_API_KEY="your-paypal-client-id"
PAYPAL_KEY="your-paypal-secret"

# ImgBB
IMGBB_API_KEY="your-imgbb-api-key"

# Cron
CRON_SECRET="your-cron-secret"

# Better Auth
BETTER_AUTH_SECRET="generate-a-32-char-secret-here"
BETTER_AUTH_URL="http://localhost:4000"
TRUSTED_ORIGINS="http://localhost:3000,https://app.veo.com.sv"

# General
PORT=4000
NODE_ENV=development

# Max JSON/urlencoded body size (e.g. base64 images); default in code is 15mb if unset
BODY_SIZE_LIMIT=15mb

# Billboard/shop cache TTL in milliseconds; default is 300000 (5 minutes)
BILLBOARD_CACHE_TTL_MS=300000

# Redis (optional – enables persistent image caching; falls back to in-memory if unset)
REDIS_URL="redis://localhost:6379"

# Billboard image Redis TTL in seconds; default is 86400 (24 hours)
BILLBOARD_IMAGE_REDIS_TTL_S=86400

# Web push (PWA). Generate once with: npx web-push generate-vapid-keys
# Leave empty to disable push notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte.dev@arhedes.com.sv"

# Brilo WebAPI (point to pruebas or producción as needed)
BRILO_WEBAPI_URL="https://arhedes-pruebas.webapi.briloerp.net/api"
BRILO_WEBAPI_TOKEN="your-brilo-webapi-token"

# In-app assistant (agent chat)
# Provider: "google" (testing, free tier) or "anthropic" (production)
AGENT_PROVIDER="google"
# Model id for the provider. Defaults to gemini-3.8-flash / claude-haiku-4-5
# (gemini-2.5-flash is no longer available to new Google API keys)
AGENT_MODEL="gemini-3.8-flash"
# Only the key of the active provider is required
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
# Required only when the Anthropic key is not scoped to a workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=""
AGENT_MAX_STEPS=12
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_RATE_LIMIT_PER_MINUTE=15
# Signs tool approvals (emails, write calls). Falls back to BETTER_AUTH_SECRET
AGENT_TOOL_APPROVAL_SECRET=""
# Optional: base URL the agent uses to call this API. Defaults to the incoming request host
AGENT_INTERNAL_API_URL=""
# Optional: Brilo ERP MCP server (read-only SQL). Leave empty to disable
BRILO_MCP_URL="https://brilomcp-seven.vercel.app/mcp"
BRILO_MCP_TOKEN=""

# CRM (Ventas)
# Encrypts the Gmail/WhatsApp tokens users connect. Falls back to BETTER_AUTH_SECRET.
CRM_TOKEN_ENCRYPTION_KEY=""
# Web app origin the Gmail OAuth callback returns to. Defaults to the first TRUSTED_ORIGINS entry
WEB_APP_URL="http://localhost:3000"
# Country code prepended to 8-digit local phone numbers
CRM_DEFAULT_PHONE_COUNTRY_CODE="503"
# Optional, non-production only: redirect every CRM email / WhatsApp to these test recipients
CRM_TEST_EMAIL_TO=""
CRM_TEST_WHATSAPP_TO=""

# Gmail (Google Cloud OAuth client, type "Web application", internal to the veo.com.sv Workspace).
# Enable the Gmail API. Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/crm/connections/gmail/callback"
CRM_GOOGLE_ALLOWED_DOMAIN="veo.com.sv"

# WhatsApp Cloud API (Meta). Each user connects their own Phone Number ID + token in CRM > Ajustes.
# Webhook URL to register in the Meta app: <API>/api/v1/crm/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"
